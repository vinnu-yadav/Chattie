rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents:
    // Any authenticated user can read public profile data (name, handle, avatar, bio, isOnline)
    // Only the user themselves can update their profile or read their private Chat ID / password
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Direct Messages:
    // Only sender or receiver can read or write messages in that conversation
    match /messages/{messageId} {
      allow read: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.receiverId == request.auth.uid || 
        resource.data.senderId == request.auth.uid
      );
      allow delete: if request.auth != null && resource.data.senderId == request.auth.uid;
    }

    // Conversations summary records:
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
    }

    // Friend requests:
    // Sender and receiver can read/write their own friend requests
    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.receiverId == request.auth.uid || 
        resource.data.senderId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
    }

    // WebRTC signaling calls:
    match /calls/{callId} {
      allow read, write: if request.auth != null;
    }
  }
}
